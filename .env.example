# Past Exam Library - Environment Configuration Guide
# In production (Vercel), add these in Project Settings -> Environment Variables.

# Administrator Password for Management Portal
ADMIN_PASSWORD=your_secure_admin_password_here

# JWT Signing Secret (Generate a strong random string)
JWT_SECRET=past_exam_library_super_secret_jwt_key_2026

# Supabase (Optional Cloud Database & OAuth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_publishable_key
