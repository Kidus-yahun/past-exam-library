{
  "version": 2,
  "rewrites": [
    { "source": "/data(.*)", "destination": "/api/index.js" },
    { "source": "/server(.*)", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/exams/(.*)", "destination": "/api/index.js" },
    { "source": "/package.json", "destination": "/api/index.js" },
    { "source": "/package-lock.json", "destination": "/api/index.js" },
    { "source": "/vercel.json", "destination": "/api/index.js" },
    { "source": "/.env(.*)", "destination": "/api/index.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
