{
  "name": "past-exam-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vite",
    "build": "panda codegen && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:import": "bun scripts/import-legacy.ts"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.40.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/noto-sans-ethiopic": "^5.3.0",
    "@solidjs/router": "^1.0.3",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/solid-query": "^5.107.1",
    "solid-js": "^1.9.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/preset-base": "^2.5.0",
    "@pandacss/preset-panda": "^2.5.0",
    "@types/bun": "^1.4.4",
    "supabase": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^5.1.0"
  }
}
